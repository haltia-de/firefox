// haltia-firefox: mobile-config-firefox's autoconfig, then haltia-calm.js.
try {
  Components.classes["@mozilla.org/moz/jssubscript-loader;1"]
    .getService(Components.interfaces.mozIJSSubScriptLoader)
    .loadSubScript("file:///usr/lib/firefox/mobile-config-autoconfig.js");
} catch (e) {}
try {
  Components.classes["@mozilla.org/moz/jssubscript-loader;1"]
    .getService(Components.interfaces.mozIJSSubScriptLoader)
    .loadSubScript("file://@SHARE@/haltia-calm.js");
} catch (e) {}
