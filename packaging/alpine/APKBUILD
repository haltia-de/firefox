# Maintainer: Mikhail Nevskiy <rensomail@gmail.com>
pkgname=haltia-firefox
pkgver=2.0.0
pkgrel=0
pkgdesc="Firefox for a touch screen and weak hardware: large toolbar, lean prefs, uBlock Origin Lite"
url="https://github.com/haltia-de/firefox"
arch="noarch"
# The name before ADR 0004: apk upgrade carries b8k-firefox over to this.
provides="b8k-firefox=$pkgver-r$pkgrel"
replaces="b8k-firefox"
license="GPL-2.0-only"
depends="firefox mobile-config-firefox python3"
install="$pkgname.post-install $pkgname.post-upgrade"
# firefox and mobile-config-firefox both install into this directory.
# Their upgrades do not run our post-install, so the trigger does.
triggers="$pkgname.trigger=/usr/lib/firefox"
options="!check net"
source="$pkgname-$pkgver.tar.gz::https://github.com/haltia-de/firefox/archive/v$pkgver.tar.gz"
builddir="$srcdir/firefox-$pkgver"

package() {
	HALTIA_CACHE="$srcdir" sh ./install.sh "$pkgdir" /usr
}

# `abuild checksum` fills this in for a release.
sha512sums="SKIP"
