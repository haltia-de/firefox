#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# What depends on the Firefox installed, run by install.sh, the package's
# post-install and post-upgrade, and the apk trigger on /usr/lib/firefox:
# /etc/firefox/policies/policies.json from mobile-config-firefox's (uBlock
# Origin Lite in complete mode, the Russian language pack when it is for
# this Firefox's version), and the shell's old b8k-webapp.js loader taken
# out of mobile-config-firefox's autoconfig. ROOT (empty: this system) as
# for install.sh.
set -eu
root=${ROOT:-}
here=$(cd "$(dirname "$0")" && pwd)
share=${here#"$root"}
ff=$root/usr/lib/firefox
ru_for=151.0.3
ubol=$share/ubol.xpi
[ -f "$root$ubol" ] || ubol=
ru=$share/langpack-ru.xpi
ff_ver=$(sed -n 's/^Version=//p' "$ff/application.ini" 2>/dev/null | head -1)
if [ ! -f "$root$ru" ] || [ "$ff_ver" != "$ru_for" ]; then
	[ -z "$ff_ver" ] || [ "$ff_ver" = "$ru_for" ] ||
		echo "haltia-firefox: the Russian language pack is for Firefox $ru_for, not $ff_ver" >&2
	ru=
fi
if [ -f "$ff/distribution/policies.json" ]; then
	mkdir -p "$root/etc/firefox/policies"
	python3 "$here/haltia-policies.py" "$ff/distribution/policies.json" \
		"$root/etc/firefox/policies/policies.json" "$ubol" "$ru"
fi
mc=$ff/mobile-config-autoconfig.js
if [ -f "$mc" ] && grep -q 'b8k-webapp.js' "$mc"; then
	python3 - "$mc" "$here/haltia-policies.py" <<'EOT'
import importlib.util
import re
import sys

spec = importlib.util.spec_from_file_location("haltia_policies", sys.argv[2])
policies = importlib.util.module_from_spec(spec)
spec.loader.exec_module(policies)
path = sys.argv[1]
text = open(path).read()
text = re.sub(r'try \{\n  Components\.classes\["@mozilla\.org/moz/jssubscript-loader;1"\]\n'
              r'    \.getService\(Components\.interfaces\.mozIJSSubScriptLoader\)\n'
              r'    \.loadSubScript\("file://[^"]*b8k-webapp\.js"\);\n\} catch \(e\) \{\}\n',
              '', text)
policies.atomic_write(path, text)
EOT
fi
