#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Make Firefox's profiles fit a touch screen and weak hardware:
#   haltia-firefox-profile [--shell] [OPTIONS] (see --help)
# Makes a default profile when there is none, copies the large toolbar
# (userChrome.css) and userContent.css into every profile's chrome folder,
# and adds the UI prefs it needs to user.js. Hardware defaults come from
# haltia-ram.js, so manual profile overrides remain effective. With
# --shell (the Haltia shell), the toolbars also leave room for the shell's
# home and close buttons, the tab row is as tall as the other programs'
# header, and Firefox's own window buttons are gone (userChrome-shell.css). Run it before
# starting Firefox; it changes only what differs.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
share=$(dirname "$here")/share/haltia-firefox
[ -f "$share/userChrome.css" ] || share=$here
for arg in "$@"; do
	case "$arg" in -h|--help) exec python3 "$share/haltia-profile-prefs.py" --help ;; esac
done
python3 "$share/haltia-profile-prefs.py" --check "$@"
home=${HOME:-/home/user}
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cp "$share/userChrome.css" "$tmp/userChrome.css"
case " $* " in *" --shell "*)
	printf '\n' >> "$tmp/userChrome.css"
	cat "$share/userChrome-shell.css" >> "$tmp/userChrome.css"
esac
cp "$share/userContent.css" "$tmp/userContent.css"
root=$home/.config/mozilla/firefox
if [ ! -e "$root/profiles.ini" ] && [ ! -e "$home/.mozilla/firefox/profiles.ini" ]; then
	# The profile folder keeps the name before ADR 0004: it holds the
	# person's data.
	mkdir -p "$root/b8k.default"
	printf '%s\n' '[Profile0]' 'Name=default' 'IsRelative=1' 'Path=b8k.default' \
		'Default=1' '' '[General]' 'StartWithLastProfile=1' 'Version=2' >"$root/profiles.ini"
fi
	for root in "$home/.config/mozilla/firefox" "$home/.mozilla/firefox"; do
		[ -d "$root" ] || continue
		for prof in "$root"/*.*; do
			[ -d "$prof" ] || continue
			mkdir -p "$prof/chrome"
			for css in userChrome.css userContent.css; do
				want=$tmp/$css
				if ! cmp -s "$want" "$prof/chrome/$css" 2>/dev/null; then
					cp "$want" "$prof/chrome/$css"
					chmod 644 "$prof/chrome/$css" 2>/dev/null || true
				fi
			done
			python3 "$share/haltia-profile-prefs.py" --profile "$prof" "$@"
		done
	done
